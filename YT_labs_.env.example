# YT.labs SaaS Environment Configuration

# ========== SERVER CONFIG ==========
PORT=3456
NODE_ENV=production
FRONTEND_URL=https://ytlabs.com

# ========== SUPABASE CONFIG ==========
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ========== STRIPE CONFIG ==========
STRIPE_PUBLIC_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Basic plan Stripe price ID ($15/month)
STRIPE_BASIC_PRICE_ID=price_xxxxx

# Pro plan Stripe price ID ($55/month)
STRIPE_PRO_PRICE_ID=price_xxxxx

# ========== AI API KEYS ==========

# Google Gemini API (for free tier)
GOOGLE_GEMINI_API_KEY=your-gemini-key

# OpenAI API (for Pro tier)
OPENAI_API_KEY=sk-xxxxx

# Replicate API (for image generation)
REPLICATE_API_KEY=r8_xxxxx

# ========== YOUTUBE CONFIG ==========
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_API_KEY=your-api-key
YOUTUBE_REDIRECT_URI=http://localhost:3456/auth/youtube/callback

# ========== DATABASE CONFIG ==========
DATABASE_URL=postgresql://user:password@localhost:5432/ytlabs

# ========== EMAIL CONFIG ==========
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@ytlabs.com

# ========== LOGGING ==========
LOG_LEVEL=info

# ========== SECURITY ==========
JWT_SECRET=your-jwt-secret-key
PASSWORD_SALT_ROUNDS=10

# ========== STORAGE ==========
AWS_S3_BUCKET=ytlabs-videos
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ========== MONITORING ==========
SENTRY_DSN=https://your-sentry-dsn

# ========== FEATURE FLAGS ==========
ENABLE_FREE_TRIAL=true
FREE_TRIAL_VIDEO_LIMIT=2
TRIAL_EXPIRES_DAYS=14
